# SecureCode AI Environment Configuration

# Service & API
PROJECT_NAME="SecureCode AI"
VERSION="1.0.0"
API_PREFIX="/api/v1"

# Database Configuration (SQLite for local / PostgreSQL for production)
DATABASE_URL="sqlite:///./data/securecode.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/securecode_db"

# Local Ollama LLM Configuration (Air-Gapped: Zero External APIs)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_SECONDS=90

# Vector Database & Embeddings
CHROMA_PERSIST_DIR="./data/chroma"
UPLOAD_DIR="./data/uploads"
REPORTS_DIR="./data/reports"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Security & Policies
MAX_UPLOAD_SIZE_MB=50
CONFIDENCE_THRESHOLD=0.65
ENABLE_LOCAL_PRIVACY_ENFORCEMENT=true

# Frontend Configuration
BACKEND_URL="http://127.0.0.1:8000/api/v1"
